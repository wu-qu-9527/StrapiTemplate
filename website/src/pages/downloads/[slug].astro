---
import Layout from '../../layouts/Layout.astro';
import { content, productUrl } from '../../lib/content';
export function getStaticPaths() { return content.products.map((entry: any) => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props;
---
<Layout title={`${entry.title}下载`} description={`下载${entry.title}，查看各平台最新版本和安装说明。`}><section class="wrap downloads-page"><a class="text-link" href="/downloads/">← 返回下载中心</a><div class="download-heading"><div class="section-label">产品下载 / DOWNLOADS</div><h1>{entry.title}</h1><p class="page-intro">选择适合你的平台。这里会从后台获取最新的版本与文件。</p><a class="text-link" href={productUrl(entry.slug)}>查看产品介绍 ↗</a></div><div id="download-root" data-mode="product" data-slug={entry.slug} aria-live="polite"><p class="loading">正在获取最新下载信息…</p></div><noscript><p>请启用 JavaScript，以访问后台 API 获取最新下载信息。</p></noscript><p class="download-help">安装文件由运营维护。下载前请确认适用平台，并按版本说明安装；如提供 SHA256，可用于检查文件完整性。</p></section></Layout>
<script src="../../scripts/downloads.ts"></script>
