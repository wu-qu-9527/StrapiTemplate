---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { content, home, brand, safeUrl } from '../lib/content';
---
<Layout>
<section class="hero wrap" id="home"><div class="hero-copy"><div class="eyebrow"><span class="dot"></span><span>{home?.eyebrow || 'IDEAS INTO IMPACT'}</span></div><h1>{home?.slogan || '首页内容尚未发布'}</h1><p class="hero-description">{home?.subtitle || ''}</p><a href="#product-list" class="button dark">了解我们的产品 <span aria-hidden="true">↗</span></a><span class="hero-index">01 / 每一个想法，都值得向前一步</span></div><div class="hero-art" aria-label="品牌主视觉">{safeUrl(home?.heroImage?.url, true) ? <img src={safeUrl(home.heroImage.url, true)} alt={home.heroImage.alternativeText || brand}/> : <><div class="art-grid"></div><div class="art-ring ring-one"></div><div class="art-ring ring-two"></div><span class="art-arrow" aria-hidden="true">↗</span><span class="art-top">NEW PERSPECTIVES.<br/>NEW POSSIBILITIES.</span><span class="art-bottom">向 新 而 行 <span>✳</span></span></>}</div></section>
<div class="ticker" aria-hidden="true"><span>好奇心驱动</span><span>✳</span><span>从想法到行动</span><span>✳</span><span>让改变发生</span><span>✳</span><span>STAY CURIOUS. MOVE FORWARD.</span><span>↗</span></div>
<section class="about wrap" id="about"><div class="section-label">01 — 关于我们</div><div class="about-content"><h2>{home?.aboutTitle || '关于我们'}</h2><p>{home?.aboutText || '公司介绍尚未发布。'}</p><div class="about-values"><span>以人为本</span><span>持续探索</span><span>协作共创</span></div></div></section>
<section class="products wrap" id="product-list"><div class="section-heading"><div><div class="section-label">02 — 产品发布</div><h2>把好想法，<span>做成好产品。</span></h2></div><a class="text-link" href="/downloads/">前往下载中心 ↓</a></div><div class="product-list">{content.products.length ? content.products.map((product: any, index: number) => <ProductCard product={product} index={index}/>) : <p class="empty">产品正在准备中，欢迎关注后续发布。</p>}</div></section>
<section class="stories wrap" id="stories"><div class="section-heading"><div><div class="section-label">03 — 最新动态</div><h2>发生着的，<span>新鲜事。</span></h2></div><p>记录探索，也分享每一次新的出发。</p></div><div class="filters" aria-label="帖子分类"><button class="filter active" data-category="all" aria-pressed="true">全部动态</button>{['公司动态','产品资讯','活动推广'].map(category => <button class="filter" data-category={category} aria-pressed="false">{category}</button>)}</div><div class="post-grid">{content.posts.map((post: any, index: number) => <article class="post-card" data-post-category={post.category}><div class="post-visual">{safeUrl(post.cover?.url, true) ? <img src={safeUrl(post.cover.url, true)} alt={post.cover.alternativeText || post.title} loading="lazy"/> : <><span class="visual-symbol" aria-hidden="true">{['↗','✳','◎'][index % 3]}</span><span class="visual-line"></span><span class="visual-label">XIN / {String(index+1).padStart(2,'0')}</span></>}</div><div class="post-meta"><span>{post.category}</span><time>{new Date(post.publishedAt).toLocaleDateString('zh-CN',{timeZone:'Asia/Shanghai'})}</time></div><h3>{post.title}</h3><p>{post.summary}</p><a class="text-link" href={`/posts/${encodeURIComponent(post.slug)}/`}>阅读故事 ↗</a></article>)}</div><p class="empty" id="no-posts" hidden={content.posts.length > 0}>这个分类还没有已发布的动态。</p></section>
<section class="careers" id="careers"><div class="wrap careers-inner"><div class="careers-copy"><div class="section-label">04 — 加入我们</div><h2>下一步，<br/>一起向前。</h2><p>带着你的好奇心与热爱，<br/>一起把更多想法变成现实。</p><span class="careers-mark" aria-hidden="true">✳</span></div><div class="job-list">{content.jobs.length ? content.jobs.map((job: any) => <a class="job" href={`/jobs/${encodeURIComponent(job.slug)}/`}><div class="job-top"><h3>{job.title}</h3><span class="job-arrow">↗</span></div><div class="job-meta"><span>{job.department}</span><span>{job.location}</span><span>{job.employmentType}</span></div><p class="job-summary">{job.summary}</p></a>) : <p class="empty">目前没有开放岗位，欢迎关注后续动态。</p>}</div></div></section>
<section class="contact wrap" id="contact"><div><div class="section-label">05 — 保持联系</div><h2>好想法，<br/>从一句“你好”开始。</h2></div><div class="contact-details"><a class="contact-link" href={home?.contactEmail ? `mailto:${home.contactEmail}` : undefined}>{home?.contactEmail || '联系方式尚未发布'}</a><p>{home?.address}</p><p class="demo-note">这是一个可编辑的示例站。演示品牌、产品、岗位与邮箱，请在正式使用前替换。</p></div></section>
</Layout>
<script>
document.querySelectorAll<HTMLButtonElement>('.filter').forEach(button => { button.addEventListener('click', () => { const category = button.dataset.category; let count = 0; document.querySelectorAll<HTMLElement>('[data-post-category]').forEach(card => { card.hidden = category !== 'all' && card.dataset.postCategory !== category; if (!card.hidden) count++; }); document.querySelectorAll<HTMLButtonElement>('.filter').forEach(other => { other.classList.toggle('active', other === button); other.setAttribute('aria-pressed', String(other === button)); }); document.querySelector<HTMLElement>('#no-posts')!.hidden = count > 0; }); });
// Keep previously shared hash links working after migrating to independent pages.
const match = location.hash.match(/^#(product|post|job)\/(.+)$/);
if (match) { const types: Record<string,string> = {product:'products',post:'posts',job:'jobs'}; location.replace(`/${types[match[1]]}/${encodeURIComponent(decodeURIComponent(match[2]))}/`); }
</script>
