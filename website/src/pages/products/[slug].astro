---
import Layout from '../../layouts/Layout.astro';
import { content, blocks, safeUrl, downloadsUrl } from '../../lib/content';
export function getStaticPaths() { return content.products.map((entry: any) => ({ params: { slug: entry.slug }, props: { entry } })); }
const { entry } = Astro.props;
---
<Layout title={entry.title} description={entry.summary}><article class="wrap detail-page"><a class="text-link" href="/#product-list">← 返回产品列表</a><div class="detail-heading"><div class="section-label">产品介绍 / PRODUCTS</div><h1>{entry.title}</h1>{entry.tagline && <p class="product-tagline">{entry.tagline}</p>}<p class="detail-summary">{entry.summary}</p><div class="detail-meta">{[entry.version,entry.releaseDate,entry.pricing].filter(Boolean).join(' · ')}</div></div>{safeUrl(entry.cover?.url,true) && <img class="detail-cover" src={safeUrl(entry.cover.url,true)} alt={entry.cover.alternativeText || entry.title}/>}<div class="detail-actions"><a class="button dark" href={downloadsUrl(entry.slug)}>下载产品 ↓</a>{safeUrl(entry.ctaUrl) && <a class="button secondary" href={safeUrl(entry.ctaUrl)} rel="noopener noreferrer">{entry.ctaLabel || '咨询产品'} ↗</a>}</div>{entry.highlights && <ul class="product-highlights">{entry.highlights.split(/\r?\n/).filter(Boolean).map((line: string) => <li>{line}</li>)}</ul>}{entry.gallery?.length > 0 && <div class="product-gallery">{entry.gallery.map((media: any) => safeUrl(media.url,true) && <img src={safeUrl(media.url,true)} alt={media.alternativeText || entry.title} loading="lazy"/>)}</div>}<div class="detail-body" set:html={blocks(entry.description)}/></article></Layout>
